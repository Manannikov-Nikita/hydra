{
  "description": "Post-pilot Hydra semantic telemetry hooks.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env HYDRA_CODEX_HOOK_SOURCE=plugin hydra-codex-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env HYDRA_CODEX_HOOK_SOURCE=plugin hydra-codex-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
