{
  "description": "Project-local Hydra semantic telemetry hooks.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3.12 \"$(git rev-parse --show-toplevel)/integrations/codex/hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3.12 \"$(git rev-parse --show-toplevel)/integrations/codex/hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3.12 \"$(git rev-parse --show-toplevel)/integrations/codex/hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
